import numpy as np
import random
import arcade
import time

class Game(arcade.Window):

    def __init__(self, grid_size, num_agents, goal_state):
        super().__init__(600, 600, "Q-Learning Path Finding")
        self.grid_size = grid_size
        self.cell_size = self.width // self.grid_size  # Calculate cell size dynamically
        self.n_states = self.grid_size * self.grid_size
        self.n_actions = 4
        self.num_agents = num_agents
        self.Q_tables = [np.zeros((self.n_states, self.n_actions)) for _ in range(num_agents)]
        self.learning_rate = 0.8
        self.discount_factor = 0.95
        self.exploration_prob = 0.3  # Reduce exploration probability
        self.actions = {
            0: -self.grid_size,  # Up
            1: self.grid_size,  # Down
            2: -1,  # Left
            3: 1  # Right
        }
        self.initial_positions = []
        for i in range(num_agents):
            self.initial_positions.append(random.randint(0, (self.grid_size * self.grid_size) - 1))
        self.current_states = self.initial_positions.copy()
        self.paths = [[pos] for pos in self.initial_positions]  # Initialize paths correctly
        self.iterations = [0] * num_agents
        self.colors = [
            arcade.color.BLUE, arcade.color.GRAY, arcade.color.GREEN, arcade.color.YELLOW, arcade.color.ORANGE,
            arcade.color.RED, arcade.color.PINK, arcade.color.BROWN, arcade.color.CYAN,
            arcade.color.MAGENTA,
        ]
        self.darker_colors = [
            arcade.color.DARK_BLUE, arcade.color.DARK_GRAY, arcade.color.DARK_GREEN, arcade.color.DARK_YELLOW, arcade.color.DARK_ORANGE,
            arcade.color.DARK_RED, arcade.color.DARK_PINK, arcade.color.DARK_BROWN, arcade.color.DARK_CYAN,
            arcade.color.DARK_MAGENTA,
        ]
        self.goal_reached = [False] * num_agents
        self.start_time = time.time()
        self.goal_state = goal_state
        self.max_time = 20  # Maximum time allowed to reach the goal
        self.walls = set()  # Initialize walls set

    def reset_agents(self):
        self.current_states = self.initial_positions.copy()
        self.paths = [[pos] for pos in self.initial_positions]
        self.iterations = [0] * self.num_agents
        self.goal_reached = [False] * self.num_agents
        self.start_time = time.time()

    def on_draw(self):
        arcade.start_render()

        for agent_id in range(self.num_agents):
            for state in self.paths[agent_id]:
                row, col = divmod(state, self.grid_size)
                arcade.draw_rectangle_filled(col * self.cell_size + self.cell_size // 2, 
                                             self.height - row * self.cell_size - self.cell_size // 2, 
                                             self.cell_size, self.cell_size, self.colors[agent_id])
        
        for agent_id in range(self.num_agents):
            current_state = self.paths[agent_id][-1]
            current_row, current_col = divmod(current_state, self.grid_size)
            arcade.draw_rectangle_filled(current_col * self.cell_size + self.cell_size // 2, 
                                         self.height - current_row * self.cell_size - self.cell_size // 2, 
                                         self.cell_size, self.cell_size, self.darker_colors[agent_id])

        end_row, end_col = divmod(self.goal_state, self.grid_size)
        arcade.draw_rectangle_filled(end_col * self.cell_size + self.cell_size // 2, 
                                     self.height - end_row * self.cell_size - self.cell_size // 2, 
                                     self.cell_size, self.cell_size, arcade.color.WHITE)
    
    def on_update(self, delta_time):
        elapsed_time = time.time() - self.start_time
        if elapsed_time > self.max_time:
            self.reset_agents()
            return

        for agent_id in range(self.num_agents):
            if not self.goal_reached[agent_id]:
                if self.current_states[agent_id] != self.goal_state:
                    valid_action = False
                    while not valid_action:
                        if np.random.rand() < self.exploration_prob:
                            action = np.random.randint(0, self.n_actions)  # Explore
                        else:
                            action = np.argmax(self.Q_tables[agent_id][self.current_states[agent_id]])
                        next_state = self.current_states[agent_id] + self.actions[action]
                        row, col = divmod(self.current_states[agent_id], self.grid_size)
                        if action == 0 and row == 0:  # Up
                            next_state = self.current_states[agent_id]
                        elif action == 1 and row == self.grid_size - 1:  # Down
                            next_state = self.current_states[agent_id]
                        elif action == 2 and col == 0:  # Left
                            next_state = self.current_states[agent_id]
                        elif action == 3 and col == self.grid_size - 1:  # Right
                            next_state = self.current_states[agent_id]
                        if next_state not in self.walls and next_state != self.current_states[agent_id]:
                            valid_action = True
                    reward = -0.1  # Small negative reward for each step
                    if next_state == self.goal_state:
                        reward = 1 + (self.max_time - elapsed_time)  # Add time-based reward
                    # Debug print to understand the Q-values and actions
                    self.Q_tables[agent_id][self.current_states[agent_id], action] += self.learning_rate * \
                        (reward + self.discount_factor *
                        np.max(self.Q_tables[agent_id][next_state]) - self.Q_tables[agent_id][self.current_states[agent_id], action])
                    self.current_states[agent_id] = next_state
                    self.paths[agent_id].append(next_state)
                    self.iterations[agent_id] += 1
                else:
                    self.goal_reached[agent_id] = True
                    print(f"Agent {agent_id} reached the goal state.")
        
        if all(self.goal_reached):
            self.reset_agents()

def main():
    grid_size = 200
    game = Game(grid_size=grid_size, num_agents=10, goal_state=random.randint(0, (grid_size * grid_size) - 1))
    arcade.run()

if __name__ == "__main__":
    main()